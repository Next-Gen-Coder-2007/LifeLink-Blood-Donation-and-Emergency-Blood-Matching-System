# Server Configuration
PORT=8000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/lifelink
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifelink?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/lifelink

# Client URL for CORS
CLIENT_URL=http://localhost:5173
